
#include <iostream>
#include <vector>
#include <queue>
#include <climits>
using namespace std;

void primMST(int V, const vector<vector<pair<int, int>>>& adj) {
    vector<int> key(V, INT_MAX), parent(V, -1);
    vector<bool> inMST(V, false);

    priority_queue<pair<int, int>,
                   vector<pair<int, int>>,
                   greater<pair<int, int>>> pq;

    key[0] = 0;
    pq.push({0, 0});

    long long totalCost = 0;
    int edges = 0;

    while (!pq.empty()) {
        int u = pq.top().second;
        pq.pop();

        if (inMST[u]) continue;
        inMST[u] = true;

        if (parent[u] != -1) {
            cout << parent[u] + 1 << " - " << u + 1
                 << " : " << key[u] << '\n';
            totalCost += key[u];
            edges++;
        }

        for (const auto& [v, weight] : adj[u]) {
            if (!inMST[v] && weight < key[v]) {
                key[v] = weight;
                parent[v] = u;
                pq.push({key[v], v});
            }
        }
    }

    if (edges != V - 1) {
        cout << "Error: Graph is disconnected.\n";
        return;
    }

    cout << "Total MST Cost: " << totalCost << '\n';
}

int main() {
    int V, E;

    cout << "Enter number of vertices and edges: ";
    if (!(cin >> V >> E) || V <= 0 || E < 0) {
        cout << "Invalid graph dimensions.\n";
        return 1;
    }

    vector<vector<pair<int, int>>> adj(V);

    cout << "Enter edges (source destination weight):\n";

    for (int i = 0; i < E; i++) {
        int u, v, w;

        if (!(cin >> u >> v >> w) ||
            u < 1 || u > V || v < 1 || v > V || u == v) {
            cout << "Invalid edge input.\n";
            return 1;
        }

        adj[u - 1].push_back({v - 1, w});
        adj[v - 1].push_back({u - 1, w});
    }

    cout << "\nEdges in the Minimum Spanning Tree:\n";
    primMST(V, adj);

    return 0;
}
