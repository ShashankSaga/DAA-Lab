
#include <iostream>
#include <vector>
#include <climits>
#include <chrono>

using namespace std;
using namespace std::chrono;

class MatrixChain {
    int n;
    vector<int> p;
    vector<vector<long long>> dp;
    vector<vector<int>> split;

public:
    MatrixChain(int matrices, vector<int> dimensions) {
        n = matrices;
        p = dimensions;
        dp.resize(n + 1, vector<long long>(n + 1, 0));
        split.resize(n + 1, vector<int>(n + 1, 0));
    }

    void calculate() {
        for (int len = 2; len <= n; len++) {
            for (int i = 1; i <= n - len + 1; i++) {
                int j = i + len - 1;
                dp[i][j] = LLONG_MAX;

                for (int k = i; k < j; k++) {
                    long long cost = dp[i][k] + dp[k + 1][j]
                                   + 1LL * p[i - 1] * p[k] * p[j];

                    if (cost < dp[i][j]) {
                        dp[i][j] = cost;
                        split[i][j] = k;
                    }
                }
            }
        }
    }

    void printOrder(int i, int j) {
        if (i == j) {
            cout << "A" << i;
            return;
        }

        cout << "(";
        printOrder(i, split[i][j]);
        cout << " x ";
        printOrder(split[i][j] + 1, j);
        cout << ")";
    }

    void display() {
        cout << "\nMinimum Multiplications: "
             << dp[1][n];

        cout << "\nOptimal Parenthesization: ";
        printOrder(1, n);
        cout << endl;
    }
};

int main() {
    int n;

    cout << "Enter number of matrices: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid number of matrices";
        return 0;
    }

    vector<int> dimensions(n + 1);

    cout << "Enter dimensions (p0 p1 ... pn):\n";

    for (int i = 0; i <= n; i++) {
        cin >> dimensions[i];

        if (dimensions[i] <= 0) {
            cout << "Invalid dimensions";
            return 0;
        }
    }

    MatrixChain mc(n, dimensions);

    auto start = high_resolution_clock::now();

    mc.calculate();

    auto end = high_resolution_clock::now();

    mc.display();

    auto executionTime =
        duration_cast<nanoseconds>(end - start);

    cout << "\nExecution Time: "
         << executionTime.count() << " ns";

    return 0;
}
